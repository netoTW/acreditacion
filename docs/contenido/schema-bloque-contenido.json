{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somoscalidad.aiep/schema/bloque-contenido/1.0.0",
  "title": "Bloque de contenido — salida del Generador",
  "description": "Contrato FIJO entre el Generador de Contenido y el Integrador de Gamificacion. La unidad de generacion es el par (dimension, nivel_estandar): 5 dimensiones x 3 niveles = 15 unidades (ADR-003). Contenido que no valida contra este schema NO se integra (CLAUDE.md 9.3).",
  "type": "object",
  "required": [
    "version_schema",
    "dimension",
    "nivel_estandar",
    "es_contenido_prueba",
    "fuente_contenido",
    "titulo",
    "resumen",
    "modulos",
    "evaluacion",
    "medalla"
  ],
  "additionalProperties": false,

  "properties": {
    "version_schema": { "const": "1.0.0" },

    "dimension": {
      "description": "Codigo de la dimension CNA. Las 5 son fijas y vienen de la ruta oficial de AIEP.",
      "enum": ["GESTION", "DOCENCIA", "CALIDAD", "VCM", "ICI"]
    },

    "nivel_estandar": {
      "description": "Nivel de estandar CNA. Anidado: el 3 incluye al 2 y el 2 al 1.",
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },

    "es_contenido_prueba": {
      "description": "En esta etapa SIEMPRE true. Se muestra visible en la UI (S-27).",
      "const": true
    },

    "fuente_contenido": {
      "description": "De donde sale el relleno. El swap a produccion cambia solo esto (ADR-003).",
      "oneOf": [
        {
          "type": "object",
          "required": ["modo", "tema"],
          "additionalProperties": false,
          "properties": {
            "modo": { "const": "prueba" },
            "tema": { "type": "string", "minLength": 3, "maxLength": 120 }
          }
        },
        {
          "type": "object",
          "required": ["modo", "corpus_id"],
          "additionalProperties": false,
          "properties": {
            "modo": { "const": "corpus" },
            "corpus_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },

    "generador_version": { "type": "string" },

    "titulo": { "type": "string", "minLength": 5, "maxLength": 140 },
    "resumen": { "type": "string", "minLength": 20, "maxLength": 600 },

    "criterios": {
      "description": "Criterios CNA que cubre el bloque. La lista oficial de los 16 NO esta en la fuente: en el slice se generan como prueba y el experto CNA de AIEP los reemplaza en produccion.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["codigo", "nombre", "es_contenido_prueba"],
        "additionalProperties": false,
        "properties": {
          "codigo": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" },
          "nombre": { "type": "string", "minLength": 5, "maxLength": 200 },
          "es_contenido_prueba": { "const": true }
        }
      }
    },

    "modulos": {
      "description": "Cantidad segun nivel: N1=2, N2=3, N3=4 (S-32). El anidamiento se expresa en nivel_estandar_origen.",
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/modulo" }
    },

    "evaluacion": { "$ref": "#/$defs/evaluacion" },
    "medalla": { "$ref": "#/$defs/medalla" }
  },

  "allOf": [
    {
      "if": { "properties": { "nivel_estandar": { "const": 1 } } },
      "then": { "properties": { "modulos": { "minItems": 2, "maxItems": 2 } } }
    },
    {
      "if": { "properties": { "nivel_estandar": { "const": 2 } } },
      "then": { "properties": { "modulos": { "minItems": 3, "maxItems": 3 } } }
    },
    {
      "if": { "properties": { "nivel_estandar": { "const": 3 } } },
      "then": { "properties": { "modulos": { "minItems": 4, "maxItems": 4 } } }
    }
  ],

  "$defs": {
    "modulo": {
      "type": "object",
      "required": ["orden", "titulo", "cuerpo", "duracion_min", "xp", "nivel_estandar_origen", "quiz_formativo"],
      "additionalProperties": false,
      "properties": {
        "orden": { "type": "integer", "minimum": 1 },
        "titulo": { "type": "string", "minLength": 5, "maxLength": 140 },
        "cuerpo": {
          "description": "Pieza de microlearning. Markdown.",
          "type": "string",
          "minLength": 400
        },
        "duracion_min": { "type": "integer", "minimum": 3, "maximum": 30 },
        "xp": { "type": "integer", "minimum": 0 },
        "nivel_estandar_origen": {
          "description": "Tramo en que se genero el modulo. Un bloque N3 incluye modulos con origen 1, 2 y 3.",
          "type": "integer", "minimum": 1, "maximum": 3
        },
        "quiz_formativo": {
          "description": "Feedback inmediato. NO otorga completitud (S-07).",
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },

    "evaluacion": {
      "description": "Gate del bloque. Resultado al final, nunca en vivo (S-07).",
      "type": "object",
      "required": ["umbral_aprobacion", "n_items_por_intento", "max_reintentos", "minutos_expiracion", "banco_items"],
      "additionalProperties": false,
      "properties": {
        "umbral_aprobacion": { "const": 0.8 },
        "n_items_por_intento": { "type": "integer", "minimum": 5, "maximum": 30 },
        "max_reintentos": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "minutos_expiracion": { "type": "integer", "minimum": 30, "default": 1440 },
        "banco_items": {
          "description": "Debe tener al menos el triple de n_items_por_intento para que barajar produzca pruebas distintas entre reintentos (S-06). Lo verifica el Validador, no el schema.",
          "type": "array",
          "minItems": 15,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },

    "item": {
      "type": "object",
      "required": ["enunciado", "alternativas", "indice_correcta", "explicaciones"],
      "additionalProperties": false,
      "properties": {
        "enunciado": { "type": "string", "minLength": 15, "maxLength": 500 },
        "alternativas": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "indice_correcta": {
          "description": "Exactamente una correcta. Al ser un indice unico, tener dos o cero es imposible por construccion.",
          "type": "integer", "minimum": 0, "maximum": 3
        },
        "explicaciones": {
          "description": "Una explicacion POR ALTERNATIVA, incluidas las incorrectas: el quiz formativo las muestra.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 10, "maxLength": 500 }
        },
        "criterio_codigo": { "type": "string" },
        "dificultad": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },

    "medalla": {
      "description": "Se define por (dimension, nivel), no por cargo: asi dos cargos con contenido compartido ganan insignias distintas (ADR-003).",
      "type": "object",
      "required": ["tipo", "nombre", "descripcion", "xp"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["mini", "silver", "gold", "master"] },
        "nombre": { "type": "string", "minLength": 3, "maxLength": 80 },
        "descripcion": { "type": "string", "minLength": 10, "maxLength": 300 },
        "xp": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
