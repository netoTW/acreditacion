# Copia este archivo a .env antes de levantar:
#     cp .env.example .env && docker compose up
#
# Son credenciales LOCALES de desarrollo. En producción van por el gestor de
# secretos del cliente, nunca en el repo.

POSTGRES_USER=somoscalidad
POSTGRES_PASSWORD=somoscalidad
POSTGRES_DB=somoscalidad

# Puertos que se publican en tu máquina.
# Elegidos para NO chocar con portal-inclusion, que ocupa 5432 y 8000, ni con el
# Postgres de pruebas de la API, que usa 5433. Los dos proyectos pueden correr a la vez.
PUERTO_DB=5442
PUERTO_API=8010
PUERTO_REALTIME=2567
PUERTO_WEB=5180

# Habilita la clave de respuestas del contenido de prueba en /docs. NUNCA en producción.
MODO_DEV=true

# Firma de las sesiones. En produccion va por el gestor de secretos del cliente.
SECRETO_SESION=dev-inseguro-cambiar-en-produccion

# Origenes que la API acepta desde el navegador (CORS), separados por coma.
# Vacio + MODO_DEV=true => se aceptan localhost y la red local, para probar
# desde el telefono. En produccion se listan explicitamente.
ORIGENES_PERMITIDOS=
